<text xml:lang="ta" type="edition">
  <body>
    <div rend="parallel">
      <lg xml:id="MK">
<l>vāmpariya kaṭuntiṇṭēr</l>
<l>kāṟṟeṉṉak kaṭitukoṭpavum</l>
<l>vāṇmiku maṟamaintar</l>
<l>tōṇmuṟaiyāṉ vīṟumuṟṟavu</l>
<l>miruperu vēntaroṭu vēḷir cāyap</l>
<l>porutavaraic ceruveṉṟu</l>
<l>milaṅkaruviya varai nīntic</l>
<l>curampōḻnta vikalāṟṟa</l>
<l>luyarntōṅkiya viḻucciṟappi</l>
<l>ṉilantanta pērutavip</l>
<l>polantār mārpi ṉeṭiyō ṉumpaṉ</l>
<l>marantiṉṉūu varaiyutirkku</l>
<l>naraiyurumi ṉēṟaṉaiyai</l>
<l>yaruṅkuḻumiḷaik kuṇṭukiṭaṅki</l>
<l>ṉuyarntōṅkiya niraipputavi</l>
<l>ṉeṭumati ṉiraiñāyi</l>
<l>lampumi ḻayilaruppan</l>
<l>taṇṭātu talaicceṉṟu</l>
<l>koṇṭunīṅkiya viḻucciṟappiṟ</l>
<l>ṟeṉkumari vaṭaperuṅkal</l>
<l>kuṇakuṭakaṭa lāvellait</l>
<l>toṉṟumoḻintu toḻilkēṭpa</l>
<l>veṟṟamoṭu veṟuttoḻukiya</l>
<l>koṟṟavartaṅ kōṉākuvai</l>
      </lg>
      <lg xml:lang="en">
