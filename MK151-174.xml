<text xml:lang="ta" type="edition">
  <body>
    <div rend="parallel">
      <lg xml:id="MK">
<l>mēmpaṭa marīiya velpōrk kuruci</l>
<l>luṟuceṟunar pulampukkavar</l>
<l>kaṭikāvi ṉilaitolaicci</l>
<l>yiḻipaṟiyāp peruntaṇpaṇai</l>
<l>kurūukkoṭiya verimēya</l>
<l>nāṭeṉumpēr kāṭāka</l>
<l>vācēntavaḻi mācēppa</l>
<l>vūriruntavaḻi pāḻāka</l>
<l>vilaṅkuvaḷai maṭamaṅkaiyar</l>
<l>tuṇaṅkaiyañcīrt taḻūumaṟappa</l>
<l>vavaiyirunta perumpotiyiṟ</l>
<l>kavaiyaṭik kaṭunōkkattup</l>
<l>pēymakaḷir peyarpāṭa</l>
<l>vaṇaṅkuvaḻaṅku makalāṅka</l>
<l>ṇilattāṟṟuṅ kuḻūupputavi</l>
<l>ṉarantaip peṇṭi riṉaintaṉa rakavak</l>
<l>koḻumpatiya kuṭitēmpic</l>
<l>ceḻuṅkēḷir niḻalcēra</l>
<l>neṭunakar vīḻnta karikutirp paḷḷik</l>
<l>kuṭumik kūkai kurāloṭu muralak</l>
<l>kaḻunīr polinta kaṇṇakaṉ poykaik</l>
<l>kaḷiṟumāy ceruntiyoṭu kaṇpamaṉ ṟūrtara</l>
<l>nallēr naṭanta nacaicāl viḷaivayaṟ</l>
<l>paṉmayirp piṇavoṭu kēḻa lukaḷa</l>
      </lg>
      <lg xml:lang="en">
