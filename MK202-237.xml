<text xml:lang="ta" type="edition">
  <body>
    <div rend="parallel">
      <lg xml:id="MK">
<l>teṉpula maruṅkiṉ viṇṭu niṟaiya</l>
<l>vāṇaṉ vaitta viḻuniti peṟiṉum</l>
<l>paḻinamak keḻuka veṉṉāy viḻuniti</l>
<l>yīta luḷḷamo ṭicaivēṭ kuvaiyē</l>
<l>yaṉṉāy niṉṉoṭu muṉṉilai yevaṉō</l>
<l>koṉṉoṉṟu kiḷakkuva laṭupō raṇṇal</l>
<l>kēṭṭiciṉ vāḻi keṭukaniṉ ṉavalaṅ</l>
<l>keṭātu nilaiiyarniṉ cēṇviḷaṅku nallicai</l>
<l>tavapperukkat taṟāyāṇa</l>
<l>raḻittāṉāk koḻuntiṟṟi</l>
<l>yiḻittāṉāp palacoṉṟi</l>
<l>yuṇṭāṉāk kūrnaṟaviṟ</l>
<l>ṟiṉṟāṉā viṉavaika</l>
<l>ṉilaṉeṭuk kallā voṇpal veṟukkaip</l>
<l>payaṉaṟa vaṟiyā vaḷaṅkeḻu tirunakar</l>
<l>narampiṉ muralu nayamvaru muraṟci</l>
<l>viṟaliyar vaṟuṅkaik kuṟuntoṭi ceṟippap</l>
<l>pāṇa ruvappak kaḷiṟupala tarīik</l>
<l>kalantō ruvappa veyiṟpala kaṭaii</l>
<l>maṟaṅkalaṅkat talaicceṉṟu</l>
<l>vāḷuḻantataṉ ṟāḷvāḻtti</l>
<l>nāḷīṇṭiya nallakavarkkut</l>
<l>tērōṭu mācitaṟic</l>
<l>cūṭuṟṟa cuṭarppūviṉ</l>
<l>pāṭupularnta naṟuñcāntiṉ</l>
<l>viḻumiya periyōr cuṟṟa mākak</l>
<l>kaḷḷi ṉirumpaik kalañcela vuṇṭu</l>
<l>paṇintōr tēen tamvaḻi naṭappap</l>
<l>paṇiyār tēem paṇittuttiṟai koṇmār</l>
<l>paruntupaṟak kallāp pārvaṟ pācaṟaip</l>
<l>paṭukaṇ muracaṅ kālai yiyampa</l>
<l>veṭipaṭak kaṭantu vēṇṭupulat tiṟutta</l>
<l>paṇaikeḻu peruntiṟaṟ palvēṉ maṉṉar</l>
<l>karaiporu tiraṅkuṅ kaṉaiyiru munnīrt</l>
<l>tiraiyiṭu maṇaliṉum palarē yuraicela</l>
<l>malar talai yulaka māṇṭukaḻin tōrē</l>
      </lg>
